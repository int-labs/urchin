<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required by Electron's V8. Dropping this is what makes a signed build
         crash on launch. Do NOT remove it when adding entitlements. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Without this, macOS suppresses the microphone prompt entirely under
         hardened runtime ("Policy disallows prompt"). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
